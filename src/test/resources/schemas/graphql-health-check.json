{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Schema for GraphQL __typename health-check response",
  "type": "object",
  "required": [
    "data"
  ],
  "additionalProperties": true,
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "__typename"
      ],
      "properties": {
        "__typename": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

