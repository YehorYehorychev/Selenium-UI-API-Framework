{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Schema for a GraphQL response containing at least one error. Error codes surface in errors[*].message for this API.",
  "type": "object",
  "required": [
    "errors"
  ],
  "additionalProperties": true,
  "properties": {
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "array",
              "null"
            ]
          }
        }
      }
    }
  }
}
